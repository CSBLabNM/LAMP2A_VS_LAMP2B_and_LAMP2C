; =====================
; Run parameters
; =====================
integrator  = md
dt          = 0.002
tinit       = 0
nsteps      = 50000        ; 100 ps equilibration
nstcomm     = 10

; =====================
; Output control
; =====================
nstxout-compressed  = 5000
nstenergy           = 5000
nstvout             = 5000
nstfout             = 5000

; =====================
; Bond constraints
; =====================
constraint_algorithm = lincs
constraints          = h-bonds
lincs_iter           = 1
lincs_order          = 4

; =====================
; Neighbor searching
; =====================
cutoff-scheme   = Verlet
nstlist         = 20
rlist           = 1.4
rcoulomb        = 1.4
rvdw            = 1.4

; =====================
; Electrostatics
; =====================
coulombtype     = PME
fourierspacing  = 0.12
pme_order       = 4
ewald_rtol      = 1e-5

; =====================
; Temperature coupling (NPT equilibration)
; =====================
tcoupl      = Berendsen
tc-grps     = Protein Non-Protein
tau_t       = 0.5  0.5
ref_t       = 310.15  310.15

; =====================
; Pressure coupling (NPT equilibration)
; =====================
pcoupl          = Berendsen
pcoupltype      = isotropic
tau_p           = 1.0
compressibility = 4.5e-5
ref_p           = 1.0
refcoord_scaling = com

; =====================
; Velocities
; =====================
continuation = no
gen_vel      = yes
gen_temp     = 310.15

; =====================
; PBC & dispersion
; =====================
pbc         = xyz
DispCorr    = EnerPres

; =====================
; Pull code (umbrella equilibration)
; =====================
pull                    = yes
pull-ncoords            = 1
pull-ngroups            = 2

pull-group1-name        = Chain_AB
pull-group2-name        = Chain_C

pull-group1-pbcatom     = 637
pull-group2-pbcatom     = 1593
pull-pbc-ref-prev-step-com = yes

pull-coord1-type        = umbrella
pull-coord1-geometry    = direction
pull-coord1-dim         = N N Y
pull-coord1-vec         = 0 0 1
pull-coord1-groups      = 1 2 
pull-coord1-start       = yes
pull-coord1-rate        = 0.0        ; FIXED distance (umbrella window)
pull-coord1-k           = 1000

